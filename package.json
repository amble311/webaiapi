{
  "name": "webaiapi",
  "version": "0.1.2",
  "description": "Wrap AI chat web UIs (ChatGLM) into an OpenAI-compatible API — Playwright Firefox automation, no API key needed. 把 AI 聊天网页包装成 OpenAI 兼容 API（命令名：webapi）",
  "keywords": [
    "openai",
    "api-gateway",
    "chatglm",
    "playwright",
    "browser-automation",
    "llm",
    "cli",
    "webapi"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "webapi": "bin/webapi.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "postinstall.mjs",
    "README.en.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js start",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test",
    "postinstall": "node postinstall.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "pino": "^10.4.0",
    "playwright": "^1.64.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amble311/webaiapi.git"
  },
  "homepage": "https://github.com/amble311/webaiapi#readme",
  "bugs": {
    "url": "https://github.com/amble311/webaiapi/issues"
  },
  "author": "amble311"
}
