# ======================================================================
# webaiapi 配置模板
#
# 复制为 .env 后按需修改：  cp .env.example .env
#
# ⚠️ 这份清单**就是全部会被读取的键**。写别的键不会生效，
#    启动时日志会列出「不会被读取」的键名，便于发现拼写错误。
#    历史 Python 版的 REDIS_URL / USER_DATA_DIR / MAX_INSTANCES /
#    MAX_REQUESTS_PER_INSTANCE / HEALTH_CHECK_INTERVAL / REQUEST_QUEUE_MAX_SIZE
#    均已废弃，写上也没有任何作用。
# ======================================================================

# ---- 应用 ----
# 版本号默认取自 package.json，一般不用管
APP_NAME=webaiapi
# APP_VERSION=
DEBUG=false

# ---- HTTP 服务（OpenAI 兼容）----
API_HOST=0.0.0.0
API_PORT=8631
API_PREFIX=/v1

# 工具调用的「进展」判据（替代旧的 24 轮硬上限）
# 连续多少轮**完全没有进展**（全是重复调用）就截停：正常探索不会触发。
TOOL_STALL_ROUNDS=3
# 应急上限：单次请求最多多少轮（只防真无限，正常任务碰不到）。
TOOL_ROUND_HARD_LIMIT=150

# 登录用哪个浏览器内核：firefox（默认，能过 Cloudflare Turnstile）/ chrome（可持久化档案）。
# ⚠️ 实测 ChatGPT 的 Cloudflare 验证**只放行 Firefox**；chrome 仅在有持久化需求且目标站无 CF 时用。
LOGIN_BROWSER=firefox
# 登录等交互流程使用的**持久化浏览器档案**（仅 LOGIN_BROWSER=chrome 生效）。
# ChatGPT 走 Google 登录时，空白档案 = 每次都要先登 Google ✗ —— 持久化后一次登录长期有效。
# 置空（BROWSER_PROFILE_DIR=）可退回「每次开空白档案」的旧行为。
BROWSER_PROFILE_DIR=~/.ai-api/browser/login-profile
# 想直接用你已装 Chrome 的登录态：用它启动 Chrome（--remote-debugging-port=9222），
# 再把这里填上端点。填了就不再用内置 Firefox 的档案。
BROWSER_CDP_ENDPOINT=

# ---- 浏览器 ----
# true  = 无头（服务器/CI）；false = 可见窗口（本地排查用，需要图形界面）
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=60

# ---- 凭证与历史 ----
AUTH_DIR=~/.ai-api/auth

# ---- 请求预算 ----
# 整个 HTTP 请求的硬上限（秒）。内部总预算会收敛到 270s，建议 >= 300。
REQUEST_TIMEOUT=300

# ---- 日志 ----
# LOG_LEVEL: fatal | error | warn | info | debug | trace
LOG_LEVEL=INFO
LOG_DIR=logs
DEBUG_LOGS=false

# ---- 模型 ----
AVAILABLE_MODELS=mix

# ---- 限流 ----
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# ---- API Key 认证 ----
# 留空 = 不启用认证。配了密钥且 API_KEY_REQUIRED=true 时才真正拦截。
# API_KEYS=
# API_KEY_REQUIRED=false

# ---- 工具调用兜底工作目录（可选，逗号分隔）----
# DEFAULT_WORKSPACE_PATHS=/home/you/project-a,/home/you/project-b
